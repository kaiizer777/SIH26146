# Environments & Virtualenvs
venv/
.venv/
env/
.env
.env.*
!.env.example

# Secrets
# Enforced here because frontend/.gitignore only covers the frontend subtree.
# Nothing in the repo matches these today; the point is that the next TLS cert
# or private key dropped anywhere in the tree fails `git add` silently instead
# of landing in a commit. .env/.env.* above already cover dotenv-style secrets.
*.pem
*.key
*.pfx
*.p12

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# Data & Large binary files
*.mmdb
*.tar.gz
*.pth
data/staging_graph_cache.pt
data/geoip/
data/raw/
# Generated synthetic datasets — reproducible via generate_synthetic_data.py
data/synthetic_transactions.csv
data/synthetic_transactions.json
data/synthetic_transactions.xml
data/synthetic_data.csv
# Ransomwhere seeds — downloaded at runtime via download_ransomwhere.py
data/ransomwhere_seeds.json
# XAI runtime overlay — written by xai_store on every post-ingest enrichment run.
# Durable by design, but generated state: ~20MB rewritten per run, not source.
data/xai/runtime/

# Node.js / Frontend
node_modules/
.next/
out/
build/
dist/

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
