# ---------------------------------------------------------------------------
# SIH26146 — environment template
#
#   cp .env.example .env
#
# This file is OPTIONAL for `docker compose up -d`: every value the compose
# stack needs already has a working default in docker-compose.yml, and the
# stack starts with no .env at all. Copy it only when you want to change
# something — ports, passwords, the API token, or the active model set.
#
# Two audiences read this file:
#   1. docker compose (interpolation only — it re-points the URLs at the
#      compose service names, so localhost URLs below are ignored inside Docker)
#   2. the backend when it runs on the host (dev-server.md flow), where the
#      localhost URLs below ARE the ones that matter
# ---------------------------------------------------------------------------

# ===========================================================================
# Published host ports
#
# Docker only. These are the ports on YOUR machine that map onto the container
# ports. They exist separately from the container ports so changing them can
# never break the containers' inter-container wiring.
#
# When running the backend on the host instead of in Docker, the localhost URLs
# in the next section must point at these same published ports.
# ===========================================================================
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ===========================================================================
# PostgreSQL
#
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB configure the postgres
# container AND are interpolated into DATABASE_URL, so the credentials cannot
# drift apart.
# ===========================================================================
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=sih_password
POSTGRES_DB=sih_bitcoin
# Host-side only. Container-to-container traffic always uses postgres:5432.
POSTGRES_HOST=localhost
# INERT — no module reads POSTGRES_PORT. It is listed purely so a host-side
# `psql -h $POSTGRES_HOST -p $POSTGRES_PORT` line is copy-pasteable, and the
# port it must agree with is the one below, POSTGRES_HOST_PORT. To move the
# published port under Docker, change POSTGRES_HOST_PORT (and the :5433 in
# DATABASE_URL) — changing POSTGRES_PORT alone does nothing.
POSTGRES_PORT=5433
# Host-side only (backend on the host). Inside Docker this is overridden with
# the postgres:5432 service address.
DATABASE_URL=postgresql://sih_user:sih_password@localhost:5433/sih_bitcoin

# ===========================================================================
# Neo4j 5.26 + Graph Data Science
#
# NEO4J_USER / NEO4J_PASSWORD are the single source of truth: docker-compose
# derives the container's NEO4J_AUTH from them. Setting NEO4J_AUTH on its own
# would desynchronise the server from the backend and cause auth failures, so
# it is intentionally absent here.
# ===========================================================================
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j
# Host-side only. Inside Docker this is overridden with bolt://neo4j:7687.
NEO4J_URI=bolt://localhost:7687

# ===========================================================================
# Redis & Celery task queue
#
# Host-side only. Inside Docker all three are overridden to redis://redis:6379/0.
# ===========================================================================
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0
# Number of prefork worker processes. Raise only with enough RAM to spare —
# each child loads the torch/PyG stack.
CELERY_CONCURRENCY=2

# ===========================================================================
# API authentication
#
# API_DEV_TOKEN is the static bearer token the FastAPI middleware enforces
# (app/config.py -> api_dev_token). The frontend image derives
# NEXT_PUBLIC_API_TOKEN from this same variable, so overriding API_DEV_TOKEN
# alone is sufficient and cannot leave the two sides out of sync.
#
# NEXT_PUBLIC_API_BASE / NEXT_PUBLIC_API_URL are baked into the browser bundle
# by `next build` and must therefore stay reachable FROM THE BROWSER — i.e.
# localhost, not the `fastapi` compose service name.
# ===========================================================================
API_DEV_TOKEN=dev-token-ntro-2026
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===========================================================================
# Browser origins (CORS) — READ BY THE APP
#
# CORS_ORIGINS is the comma-separated allow-list CORSMiddleware serves from
# (app/config.py -> cors_origins, app/main.py -> allow_origins). docker-compose
# forwards it into the api/worker/migrate containers, and app/main.py falls back
# to exactly this list when it is unset or empty.
#
# KEEP IN SYNC WITH FRONTEND_PORT. If you publish the frontend anywhere other
# than port 3000, add that origin here as well, e.g.
#   FRONTEND_PORT=3100
#   CORS_ORIGINS=http://localhost:3100
# otherwise the browser rejects every API response and the dashboard panels
# stay empty. One entry per origin, no spaces, no trailing slash. This is the
# only CORS knob; the API is never open to "*" when this list is set.
# ===========================================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================================================================
# GeoIP (MaxMind GeoLite2) — OPTIONAL
#
# Read only by backend/scripts/download_maxmind.py, which fetches the .mmdb
# files into data/geoip/. Docker never runs it: the container reads whatever is
# already on disk and degrades to NULL country/ASN when the databases are
# absent, which is why a clean clone still boots.
# ===========================================================================
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ===========================================================================
# Neo4j memory (Docker only)
#
# These three names are docker-compose interpolation variables, NOT Neo4j
# setting names. docker-compose.yml maps them onto:
#     NEO4J_HEAP_INITIAL_SIZE -> NEO4J_server_memory_heap_initial__size
#                                -> server.memory.heap.initial_size
#     NEO4J_HEAP_MAX_SIZE     -> NEO4J_server_memory_heap_max__size
#                                -> server.memory.heap.max_size
#     NEO4J_PAGECACHE_SIZE    -> NEO4J_server_memory_pagecache_size
#                                -> server.memory.pagecache.size
# The 4.x-era dbms.memory.* aliases also worked, but Neo4j 5.26 logged
# "Use of deprecated setting 'dbms.memory.heap.max_size'" on every boot, so
# compose now uses the server.memory.* names and the WARN is gone.
#
# Total budget is heap + pagecache and must fit in free RAM, or Neo4j refuses
# to start. Lower these first on a memory-constrained laptop. Keep
# NEO4J_HEAP_INITIAL_SIZE <= NEO4J_HEAP_MAX_SIZE — Neo4j's JVM hard-fails
# with "Initial heap size set to a larger value than the maximum heap size"
# and crash-loops if you invert them.
#
# Verify what actually took effect:
#   docker compose exec neo4j sh -c 'grep -E "^(server|dbms)\.memory" \
#     /var/lib/neo4j/conf/neo4j.conf'
# ===========================================================================
NEO4J_HEAP_INITIAL_SIZE=512m
NEO4J_HEAP_MAX_SIZE=2g
NEO4J_PAGECACHE_SIZE=1g

# ===========================================================================
# Stage 3 model architecture
#
# Anomaly detection tradeoff:
#   USE_LEGACY_ANOMALY_MODEL=false (default): FT-Transformer active (calibrated
#     F1 0.6972, precision 0.7379, recall 0.6609, ROC-AUC 0.9739)
#   USE_LEGACY_ANOMALY_MODEL=true: Autoencoder active (unsupervised baseline,
#     95th-pct threshold 0.034618)
#
# Risk scoring tradeoff:
#   USE_LEGACY_RISK_MODEL=false (default): Graph Transformer active (strictly
#     outperforms GraphSAGE: Test F1 0.9209 vs 0.8696 multi-relational,
#     Test AUC 0.9956)
#   USE_LEGACY_RISK_MODEL=true: GraphSAGE active (legacy baseline fallback,
#     co-spend F1 0.9711)
#
# These select which artefacts app/services/xai_store.py loads from data/models.
# Changing them changes the risk scores the dashboard displays.
# ===========================================================================
USE_LEGACY_ANOMALY_MODEL=false
USE_LEGACY_RISK_MODEL=false

# Deprecated master toggle (sets both models together for backward compatibility
# with older scripts). Left unset; prefer the two flags above.
# USE_LEGACY_MODELS=false

# ===========================================================================
# NOT CONSUMED BY THE BACKEND — do not uncomment these expecting an effect
#
# Listed so nobody burns time on them. Each needs an app-code change before it
# has any behaviour.
#
# SECRET_KEY=            app/config.py has no such setting; token/JWT signing is
#                         not implemented, so nothing reads it.
# ENVIRONMENT=development app/config.py has no such setting.
# GROQ_API_KEY=          no module in backend/ imports it; no LLM call is
#                         wired up yet.
# ===========================================================================
