# Environment Variables Template
# Copy this file to .env and populate with your configuration. Do not commit actual secrets.

# MaxMind GeoLite2 Configuration
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# PostgreSQL Database Configuration
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=sih_password
POSTGRES_DB=sih_bitcoin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sih_user:sih_password@localhost:5432/sih_bitcoin

# Neo4j Graph Database Configuration (Graph Data Science enabled)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_AUTH=neo4j/password123

# Redis & Celery Task Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Application Settings
ENVIRONMENT=development
SECRET_KEY=
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stage 3 Model Architecture & Legacy Fallback Configuration
# Anomaly Detection Tradeoff:
#   USE_LEGACY_ANOMALY_MODEL=false (default): FT-Transformer active (calibrated F1 0.6972, precision 0.7379, recall 0.6609, ROC-AUC 0.9739)
#   USE_LEGACY_ANOMALY_MODEL=true: Autoencoder active (unsupervised baseline, 95th-pct threshold 0.034618)
USE_LEGACY_ANOMALY_MODEL=false

# Risk Scoring Tradeoff:
#   USE_LEGACY_RISK_MODEL=false (default): Graph Transformer active (strictly outperforms GraphSAGE: Test F1 0.9209 vs 0.8696 multi-relational, Test AUC 0.9956)
#   USE_LEGACY_RISK_MODEL=true: GraphSAGE active (legacy baseline fallback, co-spend F1 0.9711)
USE_LEGACY_RISK_MODEL=false

# Deprecated master toggle (sets both models together for backward compatibility):
# USE_LEGACY_MODELS=false

